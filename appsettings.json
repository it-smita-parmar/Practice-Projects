{
  "Coupa": {
    "BaseUrl": "https://<your-coupa-tenant>",
    "InvoicesPath": "/api/invoices",
    "ApiKey": "<coupa-api-token>"
  },
  "InvoiceMappings": {
    "Profiles": {
      "OracleDefault": {
        "INVOICE_ID": "InvoiceId",
        "SUPPLIER_NAME": "SupplierName",
        "TOTAL_AMOUNT": "Amount",
        "CURRENCY": "Currency",
        "INVOICE_DATE": "InvoiceDate",
        "INVOICE_KIND": "Kind",
        "REGION": "Region",
        "SOURCE_SYSTEM": "SourceSystem"
      },
      "OracleLicensing": {
        "INVOICE_ID": "InvoiceId",
        "SUPPLIER_NAME": "SupplierName",
        "AMOUNT_LICENSE": "Amount",
        "LICENSE_CODE": "attributes.licenseCode",
        "REGION": "Region"
      },
      "DynamicsInvoice": {
        "invoiceNumber": "InvoiceId",
        "vendorName": "SupplierName",
        "grossAmount": "Amount",
        "currencyCode": "Currency",
        "invoiceDate": "InvoiceDate"
      }
    }
  },
  "TargetRouting": {
    "Targets": [
      {
        "Name": "ORACLE_US",
        "Type": "oracle",
        "ProfileName": "OracleDefault",
        "TableName": "STAGING_INVOICES",
        "Regions": [ "US" ],
        "Sources": [ "COUPA" ]
      },
      {
        "Name": "ORACLE_EU",
        "Type": "oracle",
        "ProfileName": "OracleLicensing",
        "TableName": "STAGING_LICENSE_INVOICES",
        "Regions": [ "EU" ],
        "Sources": [ "COUPA" ]
      },
      {
        "Name": "MS_DYNAMICS",
        "Type": "dynamics",
        "ProfileName": "DynamicsInvoice",
        "Regions": [ "US", "EU", "APAC" ],
        "Sources": [ "COUPA", "THIRD_PARTY" ]
      }
    ]
  },
  "OracleTargets": {
    "Connections": {
      "ORACLE_US": "User Id=user;Password=pass;Data Source=oracle-us-host:1521/service",
      "ORACLE_EU": "User Id=user;Password=pass;Data Source=oracle-eu-host:1521/service"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
